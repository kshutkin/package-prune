{
    "name": "pkgprn",
    "version": "0.12.1",
    "license": "MIT",
    "author": "Konstantin Shutkin",
    "bin": "./src/index.js",
    "type": "module",
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    },
    "types": "./types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "default": "./src/prune.js"
        },
        "./package.json": "./package.json"
    },
    "description": "Prune package.json before publish",
    "keywords": [
        "npm",
        "package",
        "cleanup",
        "pack",
        "prepack"
    ],
    "homepage": "https://github.com/kshutkin/package-prune/blob/main/pkgprn/README.md",
    "bugs": {
        "url": "https://github.com/kshutkin/package-prune/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kshutkin/package-prune.git",
        "directory": "pkgprn"
    },
    "main": "src/prune.js",
    "scripts": {
        "build": "dts-buddy",
        "prepack": "node ./src/index.js --flatten=types --flatten=src --strip-comments",
        "test": "c8 --src=. --all -r=html -r=text -r=json-summary node ./tests/run-tests.js"
    },
    "files": [
        "types",
        "src"
    ],
    "dependencies": {
        "@jridgewell/sourcemap-codec": "^1.6.0",
        "@niceties/logger": "^2.1.1",
        "@niceties/node-parseargs-plus": "^0.6.0",
        "ignore-walk": "^9.0.0",
        "minimatch": "^11.0.3",
        "npm-packlist": "^10.0.4",
        "npm-packlist-v12": "npm:npm-packlist@^11.3.0"
    },
    "devDependencies": {
        "@types/ignore-walk": "^4.0.3",
        "@types/npm-packlist": "^7.0.3",
        "@types/npm-packlist-v12": "npm:@types/npm-packlist@7.0.3",
        "c8": "^12.0.0",
        "cli-test-helper": "^0.1.2",
        "dts-buddy": "^0.8.3",
        "npm": "11.20.0",
        "npm-v12": "npm:npm@12.1.0",
        "pnpm-v11": "npm:pnpm@11.28.9",
        "pnpm-v12": "npm:pnpm@12.16.1"
    }
}
